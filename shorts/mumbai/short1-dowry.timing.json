 "shots": [
  {
   "n": 1,
   "sid": "short1-s01",
   "vo": "दहेज में सोना नहीं, घोड़े नहीं...",
   "start": 0,
   "end": 2.856,
   "dur": 2.86,
   "speech_start": 0,
   "speech_end": 2.388,
   "est": 2.5,
   "flags": []
  },
  {
   "n": 2,
   "sid": "short1-s02",
   "vo": "पूरा एक शहर!",
   "start": 2.856,
   "end": 4.349,
   "dur": 1.49,
   "speech_start": 2.936,
   "speech_end": 3.952,
   "est": 1.4,
   "flags": []
  },
  {
   "n": 3,
   "sid": "short1-s03",
   "vo": "स्वागत है, असली सीन के पहले एपिसोड में।",
   "start": 4.349,
   "end": 8.15,
   "dur": 3.8,
   "speech_start": 4.429,
   "speech_end": 7.603,
   "est": 3.5,
   "flags": []
  },
  {
   "n": 4,
   "sid": "short1-s04",
   "vo": "मैं हूँ सूत्रधार, और आज की कहानी, मुंबई की।",
   "start": 8.15,
   "end": 12.317,
   "dur": 4.17,
   "speech_start": 8.23,
   "speech_end": 11.586,
   "est": 3.8,
   "flags": []
  },
  {
   "n": 5,
   "sid": "short1-s05",
   "vo": "सोलह सौ इकसठ।",
   "start": 12.317,
   "end": 14.911,
   "dur": 2.59,
   "speech_start": 12.397,
   "speech_end": 14.003,
   "est": 1.4,
   "flags": []
  },
  {
   "n": 6,
   "sid": "short1-s06",
   "vo": "पुर्तगाल की राजकुमारी कैथरीन की शादी तय हुई, इंग्लैंड के राजा चार्ल्स द्वितीय से।",
   "start": 14.911,
   "end": 20.846,
   "dur": 5.94,
   "speech_start": 14.991,
   "speech_end": 20.273,
   "est": 5.6,
   "flags": []
  },
  {
   "n": 7,
   "sid": "short1-s07",
   "vo": "तब मुंबई, सात छोटे टापू थी।",
   "start": 20.846,
   "end": 24.314,
   "dur": 3.47,
   "speech_start": 20.926,
   "speech_end": 23.764,
   "est": 2.5,
   "flags": []
  },
  {
   "n": 8,
   "sid": "short1-s08",
   "vo": "और राज था पुर्तगालियों का।",
   "start": 24.314,
   "end": 27.096,
   "dur": 2.78,
   "speech_start": 24.394,
   "speech_end": 26.188,
   "est": 2.1,
   "flags": []
  },
  {
   "n": 9,
   "sid": "short1-s09",
   "vo": "शादी के समझौते में, दहेज की लिस्ट बनी।",
   "start": 27.096,
   "end": 30.588,
   "dur": 3.49,
   "speech_start": 27.175,
   "speech_end": 29.883,
   "est": 3.2,
   "flags": []
  },
  {
   "n": 10,
   "sid": "short1-s10",
   "vo": "अफ़्रीका का टैंजियर।",
   "start": 30.588,
   "end": 32.688,
   "dur": 2.1,
   "speech_start": 30.668,
   "speech_end": 32.257,
   "est": 1.4,
   "flags": []
  },
  {
   "n": 11,
   "sid": "short1-s11",
   "vo": "और भारत का, बॉम्बे।",
   "start": 32.688,
   "end": 35.351,
   "dur": 2.66,
   "speech_start": 32.768,
   "speech_end": 34.408,
   "est": 2,
   "flags": []
  },
  {
   "n": 12,
   "sid": "short1-s12",
   "vo": "लेकिन ट्विस्ट यहाँ है।",
   "start": 35.351,
   "end": 37.226,
   "dur": 1.88,
   "speech_start": 35.431,
   "speech_end": 36.684,
   "est": 1.8,
   "flags": []
  },
  {
   "n": 13,
   "sid": "short1-s13",
   "vo": "दहेज हाथ आने में ही, चार साल लग गए।",
   "start": 37.226,
   "end": 40.956,
   "dur": 3.73,
   "speech_start": 37.306,
   "speech_end": 40.36,
   "est": 3.8,
   "flags": []
  },
  {
   "n": 14,
   "sid": "short1-s14",
   "vo": "और तब पता चला, ये तोहफ़ा नहीं, बहुत महँगा बोझ है।",
   "start": 40.956,
   "end": 45.945,
   "dur": 4.99,
   "speech_start": 41.036,
   "speech_end": 45.156,
   "est": 4.5,
   "flags": []
  },
  {
   "n": 15,
   "sid": "short1-s15",
   "vo": "सोचिए, आप राजा होते, तो क्या करते?",
   "start": 45.945,
   "end": 49.599,
   "dur": 3.65,
   "speech_start": 46.025,
   "speech_end": 48.495,
   "est": 3.1,
   "flags": []
  },
  {
   "n": 16,
   "sid": "short1-s16",
   "vo": "राजा ने सोलह सौ अड़सठ में, पूरा बॉम्बे, ईस्ट इंडिया कंपनी को किराए पर दे दिया।",
   "start": 49.599,
   "end": 55.918,
   "dur": 6.32,
   "speech_start": 49.679,
   "speech_end": 55.126,
   "est": 6.3,
   "flags": []
  },
  {
   "n": 17,
   "sid": "short1-s17",
   "vo": "और किराया?",
   "start": 55.918,
   "end": 57.158,
   "dur": 1.24,
   "speech_start": 55.998,
   "speech_end": 56.606,
   "est": 1.2,
   "flags": []
  },
  {
   "n": 18,
   "sid": "short1-s18",
   "vo": "साल का सिर्फ़ दस पाउंड!",
   "start": 57.158,
   "end": 60.073,
   "dur": 2.91,
   "speech_start": 57.238,
   "speech_end": 59.288,
   "est": 2.4,
   "flags": []
  },
  {
   "n": 19,
   "sid": "short1-s19",
   "vo": "वही दहेज वाला टापू, आज भारत की आर्थिक राजधानी कहलाता है। मुंबई।",
   "start": 60.073,
   "end": 66.461,
   "dur": 6.39,
   "speech_start": 60.153,
   "speech_end": 65.663,
   "est": 4.9,
   "flags": []
  },
  {
   "n": 20,
   "sid": "short1-s20",
   "vo": "अब बताइए, आज मुंबई का किराया कितना होना चाहिए?",
   "start": 66.461,
   "end": 70.082,
   "dur": 3.62,
   "speech_start": 66.541,
   "speech_end": 69.497,
   "est": 3.8,
   "flags": []
  },
  {
   "n": 21,
   "sid": "short1-s21",
   "vo": "कमेंट में लिखिए।",
   "start": 70.082,
   "end": 71.857,
   "dur": 1.78,
   "speech_start": 70.162,
   "speech_end": 70.922,
   "est": 1.4,
   "flags": []
  },
  {
   "n": 22,
   "sid": "short1-s22",
   "vo": "अगली कहानी: मुंबई की वो ज़मीन, जो कभी समंदर थी।",
   "start": 71.857,
   "end": 76.69,
   "dur": 4.83,
   "speech_start": 71.937,
   "speech_end": 75.782,
   "est": 4.2,
   "flags": []
  },
  {
   "n": 23,
   "sid": "short1-s23",
   "vo": "और फिर चलेंगे, हम्पी।",
   "start": 76.69,
   "end": 78.906,
   "dur": 2.22,
   "speech_start": 76.77,
   "speech_end": 78.316,
   "est": 2,
   "flags": []
  },
  {
   "n": 24,
   "sid": "short1-s24",
   "vo": "फ़ॉलो कीजिए, ताकि अगली कहानी छूट न जाए।",
   "start": 78.906,
   "end": 81.737,
   "dur": 2.83,
   "speech_start": 78.986,
   "speech_end": 81.737,
   "est": 3.2,
   "flags": []
  }
 ]
}
