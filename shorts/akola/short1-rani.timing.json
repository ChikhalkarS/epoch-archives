 "method": "pauses (segmentation)",
 "measured": "2026-11-28",
 "shots": [
  {
   "n": 1,
   "sid": "short1-s01",
   "vo": "कहते हैं, अकोला की एक रानी शिवलिंग में समा गई थी।",
   "start": 0,
   "end": 4.621,
   "dur": 4.62,
   "speech_start": 0,
   "speech_end": 3.758,
   "est": 4.5,
   "flags": []
  },
  {
   "n": 2,
   "sid": "short1-s02",
   "vo": "स्वागत है आर्काइव फ़ाइल्स में, ये है फ़ाइल नंबर दो।",
   "start": 4.621,
   "end": 8.029,
   "dur": 3.41,
   "speech_start": 4.701,
   "speech_end": 7.391,
   "est": 4.2,
   "flags": []
  },
  {
   "n": 3,
   "sid": "short1-s03",
   "vo": "आज की कहानी, अकोला की।",
   "start": 8.029,
   "end": 10.632,
   "dur": 2.6,
   "speech_start": 8.109,
   "speech_end": 9.697,
   "est": 2.1,
   "flags": []
  },
  {
   "n": 4,
   "sid": "short1-s04",
   "vo": "लोक-कथा कहती है, यहाँ अकोलसिंह नाम का एक राजा था।",
   "start": 10.632,
   "end": 14.381,
   "dur": 3.75,
   "speech_start": 10.712,
   "speech_end": 13.801,
   "est": 4.2,
   "flags": []
  },
  {
   "n": 5,
   "sid": "short1-s05",
   "vo": "उसी के नाम पर इस जगह का नाम पड़ा, अकोला।",
   "start": 14.381,
   "end": 17.786,
   "dur": 3.41,
   "speech_start": 14.461,
   "speech_end": 16.79,
   "est": 4.2,
   "flags": []
  },
  {
   "n": 6,
   "sid": "short1-s06",
   "vo": "उसकी रानी हर आधी रात कहीं चली जाती थी।",
   "start": 17.786,
   "end": 20.753,
   "dur": 2.97,
   "speech_start": 17.866,
   "speech_end": 20.166,
   "est": 3.8,
   "flags": []
  },
  {
   "n": 7,
   "sid": "short1-s07",
   "vo": "राजा को शक हुआ।",
   "start": 20.753,
   "end": 22.201,
   "dur": 1.45,
   "speech_start": 20.833,
   "speech_end": 21.798,
   "est": 1.8,
   "flags": []
  },
  {
   "n": 8,
   "sid": "short1-s08",
   "vo": "एक रात, वो तलवार लेकर, उसके पीछे-पीछे निकल पड़ा।",
   "start": 22.201,
   "end": 25.715,
   "dur": 3.51,
   "speech_start": 22.281,
   "speech_end": 25.062,
   "est": 3.8,
   "flags": []
  },
  {
   "n": 9,
   "sid": "short1-s09",
   "vo": "लेकिन ट्विस्ट तो यहाँ है।",
   "start": 25.715,
   "end": 27.395,
   "dur": 1.68,
   "speech_start": 25.795,
   "speech_end": 26.857,
   "est": 2.4,
   "flags": []
  },
  {
   "n": 10,
   "sid": "short1-s10",
   "vo": "रानी किसी से मिलने नहीं जा रही थी।",
   "start": 27.395,
   "end": 29.61,
   "dur": 2.21,
   "speech_start": 27.475,
   "speech_end": 29.095,
   "est": 3.2,
   "flags": []
  },
  {
   "n": 11,
   "sid": "short1-s11",
   "vo": "वो राजेश्वर शिव मंदिर में पूजा करने जाती थी।",
   "start": 29.61,
   "end": 33.107,
   "dur": 3.5,
   "speech_start": 29.69,
   "speech_end": 32.314,
   "est": 3.8,
   "flags": []
  },
  {
   "n": 12,
   "sid": "short1-s12",
   "vo": "सोचो, उस पल राजा को कैसा लगा होगा?",
   "start": 33.107,
   "end": 36.454,
   "dur": 3.35,
   "speech_start": 33.187,
   "speech_end": 35.538,
   "est": 3.5,
   "flags": []
  },
  {
   "n": 13,
   "sid": "short1-s13",
   "vo": "रानी ने भगवान शिव से प्रार्थना की।",
   "start": 36.454,
   "end": 39.064,
   "dur": 2.61,
   "speech_start": 36.534,
   "speech_end": 38.246,
   "est": 2.9,
   "flags": []
  },
  {
   "n": 14,
   "sid": "short1-s14",
   "vo": "“अगर मैं निर्दोष हूँ, तो मुझे अपने में समा लो।”",
   "start": 39.064,
   "end": 43.058,
   "dur": 3.99,
   "speech_start": 39.144,
   "speech_end": 42.012,
   "est": 4.2,
   "flags": []
  },
  {
   "n": 15,
   "sid": "short1-s15",
   "vo": "और कहते हैं, रानी शिवलिंग में समा गई।",
   "start": 43.058,
   "end": 46.082,
   "dur": 3.02,
   "speech_start": 43.138,
   "speech_end": 45.356,
   "est": 3.5,
   "flags": []
  },
  {
   "n": 16,
   "sid": "short1-s16",
   "vo": "आज भी लोग शिवलिंग की एक दरार को इसी कहानी से जोड़ते हैं।",
   "start": 46.082,
   "end": 50.269,
   "dur": 4.19,
   "speech_start": 46.162,
   "speech_end": 49.55,
   "est": 5.2,
   "flags": []
  },
  {
   "n": 17,
   "sid": "short1-s17",
   "vo": "पर याद रखो, ये इतिहास नहीं, लोक-कथा है।",
   "start": 50.269,
   "end": 53.941,
   "dur": 3.67,
   "speech_start": 50.349,
   "speech_end": 53.283,
   "est": 3.5,
   "flags": []
  },
  {
   "n": 18,
   "sid": "short1-s18",
   "vo": "सच या सिर्फ़ कहानी? कमेंट में लिखो।",
   "start": 53.941,
   "end": 57.68,
   "dur": 3.74,
   "speech_start": 54.021,
   "speech_end": 56.971,
   "est": 3.1,
   "flags": []
  },
  {
   "n": 19,
   "sid": "short1-s19",
   "vo": "ऐसी ही अनसुनी कहानियों के लिए, फ़ॉलो करो।",
   "start": 57.68,
   "end": 60.508,
   "dur": 2.83,
   "speech_start": 57.76,
   "speech_end": 60.001,
   "est": 3.5,
   "flags": []
  },
  {
   "n": 20,
   "sid": "short1-s20",
   "vo": "और कमेंट में बताओ, अगली कहानी किस शहर की हो?",
   "start": 60.508,
   "end": 62.772,
   "dur": 2.26,
   "speech_start": 60.588,
   "speech_end": 62.497,
   "est": 4.2,
   "flags": []
  }
 ]
}
