 "method": "pauses (segmentation)",
 "measured": "2026-11-28",
 "shots": [
  {
   "n": 1,
   "sid": "short1-s01",
   "vo": "कहते हैं, अकोला की एक रानी शिवलिंग में समा गई थी।",
   "start": 0,
   "end": 5.567,
   "dur": 5.57,
   "speech_start": 0,
   "speech_end": 4.499,
   "est": 4.5,
   "flags": []
  },
  {
   "n": 2,
   "sid": "short1-s02",
   "vo": "स्वागत है आर्काइव फ़ाइल्स में, ये है फ़ाइल नंबर दो।",
   "start": 5.567,
   "end": 9.67,
   "dur": 4.1,
   "speech_start": 5.647,
   "speech_end": 8.867,
   "est": 4.2,
   "flags": []
  },
  {
   "n": 3,
   "sid": "short1-s03",
   "vo": "आज की कहानी, अकोला की।",
   "start": 9.67,
   "end": 12.789,
   "dur": 3.12,
   "speech_start": 9.75,
   "speech_end": 11.624,
   "est": 2.1,
   "flags": []
  },
  {
   "n": 4,
   "sid": "short1-s04",
   "vo": "लोक-कथा कहती है, यहाँ अकोलसिंह नाम का एक राजा था।",
   "start": 12.789,
   "end": 17.292,
   "dur": 4.5,
   "speech_start": 12.869,
   "speech_end": 16.556,
   "est": 4.2,
   "flags": []
  },
  {
   "n": 5,
   "sid": "short1-s05",
   "vo": "उसी के नाम पर इस जगह का नाम पड़ा, अकोला।",
   "start": 17.292,
   "end": 21.377,
   "dur": 4.08,
   "speech_start": 17.372,
   "speech_end": 20.142,
   "est": 4.2,
   "flags": []
  },
  {
   "n": 6,
   "sid": "short1-s06",
   "vo": "उसकी रानी हर आधी रात कहीं चली जाती थी।",
   "start": 21.377,
   "end": 24.928,
   "dur": 3.55,
   "speech_start": 21.457,
   "speech_end": 24.188,
   "est": 3.8,
   "flags": []
  },
  {
   "n": 7,
   "sid": "short1-s07",
   "vo": "राजा को शक हुआ।",
   "start": 24.928,
   "end": 26.671,
   "dur": 1.74,
   "speech_start": 25.008,
   "speech_end": 26.151,
   "est": 1.8,
   "flags": []
  },
  {
   "n": 8,
   "sid": "short1-s08",
   "vo": "एक रात, वो तलवार लेकर, उसके पीछे-पीछे निकल पड़ा।",
   "start": 26.671,
   "end": 30.888,
   "dur": 4.22,
   "speech_start": 26.751,
   "speech_end": 30.07,
   "est": 3.8,
   "flags": []
  },
  {
   "n": 9,
   "sid": "short1-s09",
   "vo": "लेकिन ट्विस्ट तो यहाँ है।",
   "start": 30.888,
   "end": 32.898,
   "dur": 2.01,
   "speech_start": 30.968,
   "speech_end": 32.214,
   "est": 2.4,
   "flags": []
  },
  {
   "n": 10,
   "sid": "short1-s10",
   "vo": "रानी किसी से मिलने नहीं जा रही थी।",
   "start": 32.898,
   "end": 35.564,
   "dur": 2.67,
   "speech_start": 32.978,
   "speech_end": 34.898,
   "est": 3.2,
   "flags": []
  },
  {
   "n": 11,
   "sid": "short1-s11",
   "vo": "वो राजेश्वर शिव मंदिर में पूजा करने जाती थी।",
   "start": 35.564,
   "end": 39.765,
   "dur": 4.2,
   "speech_start": 35.644,
   "speech_end": 38.766,
   "est": 3.8,
   "flags": []
  },
  {
   "n": 12,
   "sid": "short1-s12",
   "vo": "सोचो, उस पल राजा को कैसा लगा होगा?",
   "start": 39.765,
   "end": 43.772,
   "dur": 4.01,
   "speech_start": 39.845,
   "speech_end": 42.64,
   "est": 3.5,
   "flags": []
  },
  {
   "n": 13,
   "sid": "short1-s13",
   "vo": "रानी ने भगवान शिव से प्रार्थना की।",
   "start": 43.772,
   "end": 46.907,
   "dur": 3.13,
   "speech_start": 43.852,
   "speech_end": 45.894,
   "est": 2.9,
   "flags": []
  },
  {
   "n": 14,
   "sid": "short1-s14",
   "vo": "“अगर मैं निर्दोष हूँ, तो मुझे अपने में समा लो।”",
   "start": 46.907,
   "end": 51.696,
   "dur": 4.79,
   "speech_start": 46.987,
   "speech_end": 50.399,
   "est": 4.2,
   "flags": []
  },
  {
   "n": 15,
   "sid": "short1-s15",
   "vo": "और कहते हैं, रानी शिवलिंग में समा गई।",
   "start": 51.696,
   "end": 55.328,
   "dur": 3.63,
   "speech_start": 51.776,
   "speech_end": 54.455,
   "est": 3.5,
   "flags": []
  },
  {
   "n": 16,
   "sid": "short1-s16",
   "vo": "आज भी लोग शिवलिंग की एक दरार को इसी कहानी से जोड़ते हैं।",
   "start": 55.328,
   "end": 60.35,
   "dur": 5.02,
   "speech_start": 55.408,
   "speech_end": 59.445,
   "est": 5.2,
   "flags": []
  },
  {
   "n": 17,
   "sid": "short1-s17",
   "vo": "पर याद रखो, ये इतिहास नहीं, लोक-कथा है।",
   "start": 60.35,
   "end": 64.765,
   "dur": 4.41,
   "speech_start": 60.43,
   "speech_end": 63.927,
   "est": 3.5,
   "flags": []
  },
  {
   "n": 18,
   "sid": "short1-s18",
   "vo": "सच या सिर्फ़ कहानी? कमेंट में लिखो।",
   "start": 64.765,
   "end": 69.245,
   "dur": 4.48,
   "speech_start": 64.845,
   "speech_end": 68.359,
   "est": 3.1,
   "flags": []
  },
  {
   "n": 19,
   "sid": "short1-s19",
   "vo": "ऐसी ही अनसुनी कहानियों के लिए, फ़ॉलो करो।",
   "start": 69.245,
   "end": 72.638,
   "dur": 3.39,
   "speech_start": 69.325,
   "speech_end": 71.988,
   "est": 3.5,
   "flags": []
  },
  {
   "n": 20,
   "sid": "short1-s20",
   "vo": "और कमेंट में बताओ, अगली कहानी किस शहर की हो?",
   "start": 72.638,
   "end": 75.337,
   "dur": 2.7,
   "speech_start": 72.718,
   "speech_end": 74.993,
   "est": 4.2,
   "flags": []
  }
 ]
}
